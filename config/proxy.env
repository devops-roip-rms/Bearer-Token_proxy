# bearer-token-api-proxy local configuration
# Values are intentionally kept in this file and are not committed.
AUTH_BASE_URL=https://<HOST_OR_IP>
UPSTREAM_BASE_URL=https://<HOST_OR_IP>

AUTH_USERNAME=<USERNAME>
AUTH_PASSWORD=<PASSWORD>
AUTH_ACCOUNT_ID=<ACCOUNT_ID>

AUTH_CA_BUNDLE=
UPSTREAM_CA_BUNDLE=

PROXY_BIND_HOST=0.0.0.0
PROXY_PORT=8787
PROXY_API_KEY=

ALLOW_UNAUTHENTICATED_NONLOOPBACK=false

HTTP_TIMEOUT_SECONDS=30
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=10485760
TOKEN_REFRESH_SECONDS=36000
REFRESH_MARGIN_SECONDS=300
REFRESH_RETRY_SECONDS=300
STALE_TOKEN_WARNING_SECONDS=900
LOG_LEVEL=INFO
