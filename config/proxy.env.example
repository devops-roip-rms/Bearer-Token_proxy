AUTH_BASE_URL=https://auth.example.internal
UPSTREAM_BASE_URL=https://api.example.internal

AUTH_USERNAME=CHANGE_ME
AUTH_PASSWORD=CHANGE_ME

AUTH_CLIENT_ID=CHANGE_ME
AUTH_CLIENT_SECRET=CHANGE_ME

PROXY_BIND_HOST=127.0.0.1
PROXY_PORT=8787
PROXY_API_KEY=
ALLOW_UNAUTHENTICATED_NONLOOPBACK=false

AUTH_CA_BUNDLE=
UPSTREAM_CA_BUNDLE=

HTTP_TIMEOUT_SECONDS=30
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=10485760
TOKEN_REFRESH_SECONDS=3600
REFRESH_MARGIN_SECONDS=300
REFRESH_RETRY_SECONDS=300
STALE_TOKEN_WARNING_SECONDS=900
LOG_LEVEL=INFO
